{
	"name": "Rulesy",
	"image": "mcr.microsoft.com/devcontainers/base:ubuntu26.04",
	"features": {
		"ghcr.io/devcontainers/features/docker-in-docker:2": {
			"moby": false
		},
		"ghcr.io/notwillk/rulesy/rulesy@sha256:55818189d558943f00a3769579278fbf2c936d66c4c54e82e45d598ee9c38018": {
			"version": "0.7.6"
		}
	},
	"containerEnv": {
		"DEVCONTAINER": "true",
		"GITHUB_ACTIONS": "${localEnv:GITHUB_ACTIONS}"
	},
	"remoteEnv": {
		"PATH": "/home/vscode/.local/opt/codex-cli/bin:/home/vscode/.local/bin:/home/vscode/.cargo/bin:${containerEnv:PATH}"
	},
	"customizations": {
		"vscode": {
			"extensions": [
				"github.vscode-github-actions",
				"golang.go",
				"skellock.just",
				"sst-dev.opencode"
			]
		}
	},
	"postCreateCommand": "rulesy --config=.devcontainer/rulesy.yaml check --fix --non-interactive",
	"remoteUser": "vscode"
}
