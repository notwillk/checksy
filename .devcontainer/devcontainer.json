{
	"name": "Rulesy",
	"image": "mcr.microsoft.com/devcontainers/base:ubuntu26.04",
	"features": {
		"ghcr.io/devcontainers/features/docker-in-docker:2": {
			"moby": false
		},
		"ghcr.io/notwillk/rulesy/rulesy@sha256:14a84839b18b42a412e04cb7b0980889a83369381168b6f7de2d827bcf43dda9": {
			"version": "0.8.1"
		}
	},
	"containerEnv": {
		"DEVCONTAINER": "true",
		"GITHUB_ACTIONS": "${localEnv:GITHUB_ACTIONS}"
	},
	"remoteEnv": {
		"PATH": "/home/vscode/.local/opt/codex-cli/bin:/home/vscode/.local/bin:/home/vscode/.cargo/bin:${containerEnv:PATH}"
	},
	"customizations": {
		"vscode": {
			"extensions": [
				"github.vscode-github-actions",
				"golang.go",
				"skellock.just",
				"sst-dev.opencode"
			]
		}
	},
	"postCreateCommand": "bash .devcontainer/scripts/post-create.sh",
	"remoteUser": "vscode"
}
